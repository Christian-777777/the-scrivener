{
  "name": "world-oc-editor",
  "version": "1.0.0",
  "description": "中世纪风格世界OC编辑器",
  "author": "世界OC编辑器",
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "electron .",
    "lint": "tsc --noEmit",
    "icon": "node scripts/generate-icon.cjs",
    "dist:win": "npm run icon && npm run build && node scripts/package-win.cjs",
    "release": "npm run dist:win && node scripts/make-release.cjs",
    "dist": "npm run icon && npm run build && electron-builder"
  },
  "build": {
    "appId": "com.worldoc.editor",
    "productName": "世界OC编辑器",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "dir"
    },
    "forceCodeSigning": false
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^10.0.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.0",
    "sharp": "^0.33.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "wait-on": "^9.1.0"
  }
}
